<header id="top-header">
    <span class="siteName">
        <a href="/" title="Return to home page">CSE Motors</a>
    </span>
    <div id="tools">
        <!-- <a title="Click to log in" href="/account/login">My Account</a> -->
        <% if (locals.loggedin) { %>
            <a title="Logged In" href="/account">Welcome <%= locals.accountData.account_firstname %></a>
