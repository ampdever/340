<% if (title) { %>
    <h1><%= title %></h1>
    <% } else {
      res.redirect('/')
    } %>

    <%- messages() %>
    <% if (errors) { %>
        <ul class="notice">
       <% errors.array().forEach(error => { %>
         <li><%= error.msg %></li>
      <%  }) %>
       </ul>
      <% } %>

    <!-- <p>Field is required</p> -->
    <!-- The action route is a direction to a location -->
    <form class="add-classification" action="/inv/add-classification" method="post">

        <p>Name must be alphabetic characters only. No spaces allowed.</p>
        <label for="classification_name">Classification name:</label>
        <input type="text" id="classification_name" name="classification_name" required value="<%= locals.classification_name %>"
        pattern="^[A-Za-z]+$">

        <button type="submit" value="submit">Add Classification</button>
    </form>