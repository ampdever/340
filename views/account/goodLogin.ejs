<% if (title) { %>
    <h1><%= title %></h1>
    <% } else {
      res.redirect('/')
    } %>

    <%- messages() %>
    <% if (errors) { %>
        <ul class="notice">
       <% errors.array().forEach(error => { %>
         <li><%= error.msg %></li>
      <%  }) %>
       </ul>
      <% } %>

      <h2>Welcome <%= locals.accountData.account_firstname %></h2>
      <p>You're logged in</p>

      <a title="edit-account" href="/account/account">Edit Account Information</a>
      <br>

      <!--
      /* ****************************************
      *  IS THIS OKAY FOR TASK 2
      * ************************************ */ -->
      <% if (locals.accountData.account_type == 'Employee' || locals.accountData.account_type == 'Admin') { %>

        <a title="edit-inventory" href="/inv">Manage Inventory</a>

      <% } %>